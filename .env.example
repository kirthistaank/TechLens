# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:32b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.1

# Database
DATABASE_URL=sqlite:///./techlens.db

# Email digest (Gmail SMTP)
# Setup: Google Account → Security → 2-Step Verification → App Passwords → create one
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password-here
DIGEST_EMAIL_TO=kirthi.genai@gmail.com
DIGEST_EMAIL_ENABLED=true

# App
LOG_LEVEL=INFO
PIPELINE_SCHEDULE_HOUR=6
PIPELINE_SCHEDULE_MINUTE=0

# Cloud LLM placeholder (not used by default)
# OPENAI_API_KEY=sk-...
